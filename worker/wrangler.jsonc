{
	// Agdayo's own server: holds API keys and gives the app (and Claude,
	// through the MCP connector at /mcp) routes, travel times, places and guides.
	"name": "agdayo",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		// Firebase project whose sign-in tokens are accepted.
		"FIREBASE_PROJECT_ID": "agdayo-app",
		// Who may use this server (the app and Claude): "*" for every signed-in
		// Agdayo account, or comma-separated Firebase user IDs.
		"ALLOWED_UIDS": "*",
		// Accounts that are always refused (comma-separated), e.g. for abuse.
		"BLOCKED_UIDS": "",
		// Google calls each account may make per day (UTC); cached answers are free.
		"GOOGLE_DAILY_LIMIT": "300",
		// Accounts with no daily Google limit (comma-separated): your own.
		"UNLIMITED_UIDS": "RHrejSAA53gFxFrcGqkeVOUWw6U2",
		// Claude connector: Client ID of the Google OAuth "Web application" client,
		// for "Continue with Google" on the sign-in page.
		"GOOGLE_OAUTH_CLIENT_ID": "1015175012900-hing4re822ejq1b0fvstuglcohhec6j7.apps.googleusercontent.com"
	},
	"kv_namespaces": [
		{
			// Connector sign-ins and tokens. Replace with the ID printed by
			// `npx wrangler kv namespace create OAUTH_KV`.
			"binding": "OAUTH_KV",
			"id": "09b84044d3054ab3b7fc649cb417208d"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agdayo",
			// Replace with the ID printed by `npx wrangler d1 create agdayo`.
			"database_id": "ee026397-9ee2-4d32-9024-1622c8fc1eae",
			"migrations_dir": "migrations"
		},
		{
			"binding": "agdayo",
			"database_name": "agdayo",
			"database_id": "ee026397-9ee2-4d32-9024-1622c8fc1eae",
			"remote": true
		}
	]
	// Secrets, set with `npx wrangler secret put <NAME>`:
	//   GOOGLE_MAPS_API_KEY         Google Cloud key with Routes API and Places API (New)
	//   GOOGLE_OAUTH_CLIENT_SECRET  secret of the OAuth client above
	//   FIREBASE_SERVICE_ACCOUNT    Firebase service account key JSON (trips, and finding Google users' accounts)
}
